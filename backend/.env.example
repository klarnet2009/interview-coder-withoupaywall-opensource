DATABASE_URL="postgresql://user:password@localhost:5432/interview_coder"
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production"
PORT=3001
NODE_ENV=development

# AI Provider API Keys (optional — only needed for providers you want to use)
# These keys are stored server-side only and never exposed to clients
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Credits configuration
CREDITS_FREE_ON_SIGNUP=10
CREDITS_COST_EXTRACT=1
CREDITS_COST_SOLUTION=2
CREDITS_COST_DEBUG=3